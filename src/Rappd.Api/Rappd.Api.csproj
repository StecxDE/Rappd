<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>$(AssemblyName)</PackageId>
		<Title>$(AssemblyName)</Title>
		<Version>1.0.0</Version>
		<Authors>ZeiTee</Authors>
		<Company>Stecx</Company>
		<Product>Rappd</Product>
		<Description>The Api part of the Rappd Framework is a fast and simple feature used to implement rest apis.</Description>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageTags>rappd;api;rest</PackageTags>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/StecxDE/Rappd</RepositoryUrl>
		<PackageProjectUrl>https://stecx.de/Rappd</PackageProjectUrl>
		<PackageIcon>Logo_128x128.png</PackageIcon>
		<Copyright>Copyright © Zeitler Andreas 2023</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\assets\Logo_128x128.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Rappd.Api.Manifest\Rappd.Api.Manifest.csproj" />
	  <ProjectReference Include="..\Rappd.CQRS.AspNet\Rappd.CQRS.AspNet.csproj" />
	  <ProjectReference Include="..\Rappd.Data.AspNet\Rappd.Data.AspNet.csproj" />
	</ItemGroup>

</Project>
